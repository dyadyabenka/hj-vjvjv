# Скопируй этот файл в .env и заполни значения.
# Файл .env в репозиторий не коммитим!

# Нужен только ОДИН из двух ключей ниже — какой именно, определяет
# synthesis.provider в config.yaml.

# Ключ DeepSeek API (если provider: "deepseek" в config.yaml)
# Получить: https://platform.deepseek.com -> API Keys -> Create Key
DEEPSEEK_API_KEY="sk-da5fc3c2cb9a43839bea506708861808"

# Ключ Anthropic API (если provider: "anthropic" в config.yaml)
# Получить: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Токен бота от @BotFather (один бот ведёт все каналы ниже)
TELEGRAM_BOT_TOKEN="8015696058:AAEiQIhXJl4DiZUS9AKdIfkgWMnB2JbJO6A"

# Твой личный chat id — сюда бот присылает ВСЕ черновики на модерацию
# (по всем каналам, с пометкой, к какому именно они относятся).
# Узнать: напиши боту @userinfobot, он ответит твоим числовым id.
# ВАЖНО: перед первым запуском сам напиши что-нибудь своему боту (например
# /start) — иначе Telegram не даст боту написать тебе первым.
TELEGRAM_ADMIN_ID="1298034509"

# По одному TELEGRAM_CHANNEL_ID_* на каждый канал в config.yaml
# (имя переменной задаётся в config.yaml -> channels[].channel_id_env).
# Значение — @username канала либо числовой id вида -1001234567890.
TELEGRAM_CHANNEL_ID_PARASITES="-1004412626523"
TELEGRAM_CHANNEL_ID_SLEEP="-1004365308431"
TELEGRAM_CHANNEL_ID_NUTRITION="-1004225624582"
TELEGRAM_CHANNEL_ID_CRYPTO="-1004417705840"

# Ключ Pexels для картинок к постам (необязательно — без него посты идут
# без картинок). Получить бесплатно: https://www.pexels.com/api/ -> Get Started
PEXELS_API_KEY="1jyBO4n3we9DHF1W7k07resTjRlF5FKi5EsQgio2Q7hYO63pTUAaQAbg"

